# Force LF line endings for files that run inside Linux containers or as
# shell interpreters. Without this, Windows checkouts with core.autocrlf=true
# convert these to CRLF, which breaks the shebang line (e.g. "#!/bin/sh\r")
# and makes Docker fail with "exec ...: no such file or directory".
*.sh text eol=lf
Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf
