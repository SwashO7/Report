# =============================================================================
# Suraksha Labs — Production stack environment (docker-compose.prod.yml)
# Copy to .env at the repo root and fill in real values before deploying.
# Never commit real secrets.
# =============================================================================

# Public URLs (no trailing slash)
APP_URL=https://labs.example.com
API_URL=https://labs.example.com

# Postgres
POSTGRES_USER=suraksha
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=suraksha

# Secrets — generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-48+-byte-random-value
FLAG_HMAC_SECRET=replace-with-32+-byte-random-value

# Google OAuth (optional)
# Redirect URI: {API_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional — console transport used when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Suraksha Labs <no-reply@labs.example.com>

# Port for the web container
WEB_PORT=80
