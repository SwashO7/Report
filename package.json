{
  "name": "suraksha-labs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --filter='*' build",
    "test": "bun run --cwd apps/api test",
    "typecheck": "bun run --filter='*' typecheck",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:studio": "bun run --cwd apps/api db:studio",
    "up": "node scripts/up.mjs && node scripts/seed-if-empty.mjs",
    "down": "docker compose -f docker-compose.prod.yml down",
    "restart": "docker compose -f docker-compose.prod.yml restart",
    "logs": "docker compose -f docker-compose.prod.yml logs -f",
    "ps": "docker compose -f docker-compose.prod.yml ps"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0"
  }
}
