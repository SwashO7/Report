# =============================================================================
# Suraksha Labs — API environment configuration
# Copy to .env and fill in real values. Never commit real secrets.
# =============================================================================

# Core
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PORT=3000

# Database (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://suraksha:suraksha@localhost:5433/suraksha

# Secrets — generate with: bun -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-32+-char-random-secret
FLAG_HMAC_SECRET=replace-with-16+-char-random-secret

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {API_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — SMTP transport (leave empty to use the console dev transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Suraksha Labs <no-reply@surakshalabs.example>

# Storage (lab packages) — relative to apps/api
STORAGE_DIR=./storage

# Rate limiting (defaults are sensible)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
