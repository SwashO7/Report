{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@types/bun"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@suraksha/shared": ["../../packages/shared/src/index.ts"],
      "@suraksha/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "tests/**/*.ts"]
}
