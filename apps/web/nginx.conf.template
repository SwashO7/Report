# Suraksha Labs - web server config TEMPLATE.
#
# Rendered at container start by the nginx image's envsubst step. Only PORT and
# API_UPSTREAM are substituted (see NGINX_ENVSUBST_FILTER in the Dockerfile) so
# nginx's own runtime variables like $uri and $host survive untouched.
#
# Two deployment shapes, one image:
#
#   Docker Compose -> API_UPSTREAM=api:3000, PORT=80
#       nginx reverse-proxies /api/ to the api container on the compose network.
#
#   Cloud Run      -> API_UPSTREAM unset, PORT=8080
#       The load balancer routes /api/* straight to the api service, so this
#       container never sees an API request. Critically, the proxy block is then
#       NOT emitted at all: nginx resolves proxy_pass hostnames at STARTUP, so a
#       block pointing at the non-existent host "api" would stop the container
#       from booting - which is exactly what would have happened on Cloud Run.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # NOTE ON add_header INHERITANCE: nginx does NOT merge add_header directives.
    # The moment a location block declares one, every add_header inherited from
    # the server block is dropped for that location. The security headers must
    # therefore be repeated in each location that sets its own Cache-Control.

    # Security headers (server-level default, for locations that add none).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Static assets: long cache (content-hashed filenames).
    location /assets/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control "public, immutable, max-age=31536000" always;
    }

    location /brand/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control "public, max-age=604800" always;
    }

    # Written at startup by 10-api-proxy.sh: the /api/ proxy block when
    # API_UPSTREAM is set, otherwise an empty file.
    include /etc/nginx/api-proxy.conf;

    # Lightweight liveness endpoint so the platform can health check the static
    # tier without pulling the whole SPA.
    location = /healthz {
        access_log off;
        add_header Content-Type "text/plain" always;
        return 200 "ok\n";
    }

    # The entry document must NEVER be cached. It names the hashed asset
    # bundles, so a cached copy survives a redeploy and then requests chunk
    # hashes that no longer exist: every lazy-loaded route 404s and the app
    # renders a blank screen.
    location = /index.html {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control "no-store, must-revalidate" always;
    }

    # SPA fallback. Same no-store rule: these responses are index.html.
    location / {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control "no-store, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }
}
